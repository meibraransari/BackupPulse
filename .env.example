# ==============================================================================
# BackupPulse Configuration (.env)
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Console Logging & Verbosity (prints all requests and events to console in all modes)
ENABLE_CONSOLE_LOG=true
LOG_LEVEL=info

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=backup_monitor_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@postgres:5432/backup_monitor_db?schema=public

# Security & Authentication
JWT_SECRET=production_jwt_secret_please_change_me_super_secure_987654321
JWT_EXPIRES_IN=7d

# Ingestion API Key (Used by backup_agent.sh shell script across 100+ servers)
INGESTION_API_KEY=bkp_live_secret_key_12345

# Initial Admin Dashboard Credentials (auto-seeded on first run)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456

# Google Chat Webhook Integration
# Paste your Google Chat Space incoming webhook URL here:
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN
GOOGLE_CHAT_REPORT_CRON="0 9 * * *"
ENABLE_DAILY_REPORT=true
