# ==============================================================================
# BackupPulse Bootstrap Environment Variables (.env)
# ==============================================================================
# NOTE: All operational and notification configurations (Swagger OpenAPI UI, Google Chat, Slack, Discord,
# Telegram, Email/SMTP/SendGrid/SES, Alert Cron Schedules, Ingestion Keys, and
# Data Retention Rules) have been moved to PostgreSQL Database Settings.
#
# Configure and test them dynamically in the Web Dashboard under "System Settings".
# Changes apply immediately with zero container restarts and are included in DB backups!
#
# The variables below are ONLY used for initial container bootstrap:
# ==============================================================================

# Node Environment & Server Binding
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database details for postgres db container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=backup_monitor_db
POSTGRES_PORT=5432

# Set credential for web app
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@postgres:5432/backup_monitor_db?schema=public

# Security & Authentication (JWT Token Generation)
JWT_SECRET=production_jwt_secret_please_change_me_super_secure_987654321
JWT_EXPIRES_IN=7d

# Initial Admin Dashboard Credentials (auto-seeded on first run if database is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456
