# ==============================================================================
# BackupPulse Configuration (.env)
# ==============================================================================
# NOTE: BackupPulse features a Dynamic Database Settings Engine!
# 1. BOOTSTRAP ONLY: Only DATABASE_URL, PORT, HOST, JWT_SECRET, and INITIAL_ADMIN_*
#    are required to boot the container.
# 2. ZERO-RESTART SETTINGS: All notification channels (Google Chat, Slack, Discord,
#    Telegram, Email/SMTP/SendGrid/SES), alert cron schedules, and retention policies
#    are stored in the PostgreSQL database ('system_settings' table).
# 3. Admins can view, edit, test, and save settings directly from the Web Dashboard
#    under "System Settings". Saved changes apply immediately in memory without
#    requiring a container restart or downtime!
# 4. Values configured below in .env serve as automatic seed defaults on first boot.
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Console Logging & Verbosity (prints all requests and events to console in all modes)
ENABLE_CONSOLE_LOG=true
LOG_LEVEL=info

# Swagger OpenAPI Documentation UI (/api/docs)
# Set to 'true' to enable or 'false' to disable in production environments for security hardening
ENABLE_SWAGGER=true

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=backup_monitor_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@postgres:5432/backup_monitor_db?schema=public

# Security & Authentication
JWT_SECRET=production_jwt_secret_please_change_me_super_secure_987654321
JWT_EXPIRES_IN=7d

# Master Ingestion API Key (Used by backup_agent.sh shell script across 100+ servers)
INGESTION_API_KEY=bkp_live_secret_key_12345

# Initial Admin Dashboard Credentials (auto-seeded on first run)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456

# ==============================================================================
# Seed Defaults (Stored in PostgreSQL 'system_settings' table & editable in UI)
# ==============================================================================
# Cron schedule for daily backup report dispatch (default: 09:00 AM daily)
REPORT_CRON="0 9 * * *"

# --- Real-Time Instant Failure Alerting ---
# Set to 'true' to immediately dispatch an urgent alert whenever a backup reports FAILED or critical anomaly
INSTANT_ALERT_ON_FAILURE=true

# --- Channel 1: Google Chat Integration ---
# Set to 'true' to enable Google Chat daily summary & failure alerts, 'false' to disable
ENABLE_GOOGLE_CHAT=true
# Google Chat space incoming webhook URL (leave empty if channel is disabled)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN

# --- Channel 2: Slack Webhook Integration (Block Kit) ---
# Set to 'true' to enable Slack notifications
ENABLE_SLACK=false
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# --- Channel 3: Discord Webhook Integration (Rich Embeds) ---
# Set to 'true' to enable Discord notifications
ENABLE_DISCORD=false
# Discord channel webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Channel 4: Telegram Bot Alerts ---
# Set to 'true' to enable Telegram alerts
ENABLE_TELEGRAM=false
# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=
# Telegram Chat / Group ID (e.g. -100123456789 or user ID)
TELEGRAM_CHAT_ID=

# --- Channel 5: Email Delivery (SMTP / SendGrid / AWS SES) ---
# Set to 'true' to enable HTML email daily summary reports, 'false' to disable
ENABLE_SMTP=false

# Choose active email provider: 'smtp' | 'sendgrid' | 'ses' (default: smtp)
EMAIL_PROVIDER=smtp

# Default sender and recipients (used across all providers unless overridden below)
EMAIL_FROM="BackupPulse Central <alerts@yourdomain.com>"
EMAIL_TO=devops-team@yourdomain.com

# [Provider A] Standard SMTP Relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to 'true' if using port 465 (SSL/TLS direct), 'false' for STARTTLS (port 587 or 25)
SMTP_SECURE=false
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM="BackupPulse Central <alerts@yourdomain.com>"
SMTP_TO=devops-team@yourdomain.com

# [Provider B] SendGrid Web API v3
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM="BackupPulse Central <alerts@yourdomain.com>"

# [Provider C] AWS SES (Simple Email Service via AWS SDK)
AWS_SES_REGION=us-east-1
# Leave credentials blank to use AWS IAM instance profiles / ECS / EKS task roles
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM="BackupPulse Central <alerts@yourdomain.com>"

# ==============================================================================
# Database Retention & Housekeeping Policy (Auto-purge old records to prevent heavy DB usage)
# ==============================================================================
# Number of days to retain backup reports and alert send logs (default: 365 days = 1 year)
# Records older than this threshold are purged automatically
DB_RETENTION_DAYS=365
# Set to 'true' to enable automated daily cleanup cron, 'false' to disable
ENABLE_HOUSEKEEPING=true
# Cron schedule for running retention housekeeping (default: 03:00 AM daily)
HOUSEKEEPING_CRON="0 3 * * *"

