generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  email        String?        @unique
  fullName     String?        @map("full_name")
  avatar       String?
  passwordHash String         @map("password_hash")
  role         String         @default("admin") // admin, operator, viewer
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  loginLogs    UserLoginLog[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  keyHash    String    @unique
  keyPrefix  String
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model BackupReport {
  id              String   @id @default(uuid())
  serverId        String   @map("server_id")
  hostname        String
  serverIp        String?  @map("server_ip")
  projectName     String   @map("project_name")
  environment     String   @default("production")
  backupType      String   @map("backup_type") // db, code, full
  status          String   // SUCCESS, FAILED, WARNING, IN_PROGRESS
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  durationSeconds Int      @map("duration_seconds")
  backupSizeBytes BigInt   @map("backup_size_bytes")
  backupSizeHuman String?  @map("backup_size_human")
  s3Bucket        String?  @map("s3_bucket")
  s3Key           String?  @map("s3_key")
  s3Url           String?  @map("s3_url")
  checksum        String?
  zipFilename     String   @map("zip_filename")
  exitCode        Int      @default(0) @map("exit_code")
  errorMessage    String?  @map("error_message")
  stdoutLog       String?  @map("stdout_log")
  stderrLog       String?  @map("stderr_log")
  metadata        Json?
  isAnomaly       Boolean  @default(false) @map("is_anomaly")
  anomalyReason   String?  @map("anomaly_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([projectName, createdAt(sort: Desc)])
  @@index([serverId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isAnomaly, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("backup_reports")
}

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String   // GOOGLE_CHAT, SMTP
  eventType String   @map("event_type") // DAILY_REPORT, TEST_NOTIFICATION, FAILURE_ALERT
  recipient String   // Masked Webhook URL or recipient email(s)
  status    String   // SUCCESS, FAILED
  message   String   // Delivery response message or error description
  payload   Json?    // Summary metrics, subject, or delivery details
  createdAt DateTime @default(now()) @map("created_at")

  @@index([channel, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("notification_logs")
}

model UserLoginLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  username      String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  status        String   // SUCCESS, FAILED
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("user_login_logs")
}

model ServerConfig {
  id          String   @id @default(uuid())
  serverId    String   @unique @map("server_id")
  hostname    String?
  isMonitored Boolean  @default(true) @map("is_monitored") // When false, excluded from Dead Man's Snitch alerts
  muteReason  String?  @map("mute_reason")                 // Reason for excluding (e.g. Decommissioned, Test machine)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("server_configs")
}

