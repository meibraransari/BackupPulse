generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  email        String?        @unique
  fullName     String?        @map("full_name")
  avatar       String?
  passwordHash String         @map("password_hash")
  role             String         @default("admin") // admin, operator, viewer
  assignedProjects String[]       @default([]) @map("assigned_projects")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  loginLogs    UserLoginLog[]

  @@map("users")
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  serverId    String?   @map("server_id")
  projectName String?   @map("project_name")
  createdBy   String?   @map("created_by")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([keyHash])
  @@index([isActive])
  @@index([serverId])
  @@index([projectName])
  @@map("api_keys")
}

model BackupReport {
  id              String   @id @default(uuid())
  serverId        String   @map("server_id")
  hostname        String
  serverIp        String?  @map("server_ip")
  projectName     String   @map("project_name")
  environment     String   @default("production")
  backupType      String   @map("backup_type") // db, code, full
  status          String   // SUCCESS, FAILED, WARNING, IN_PROGRESS
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  durationSeconds Int      @map("duration_seconds")
  backupSizeBytes BigInt   @map("backup_size_bytes")
  backupSizeHuman String?  @map("backup_size_human")
  s3Bucket        String?  @map("s3_bucket")
  s3Key           String?  @map("s3_key")
  s3Url           String?  @map("s3_url")
  checksum        String?
  zipFilename     String   @map("zip_filename")
  exitCode        Int      @default(0) @map("exit_code")
  errorMessage    String?  @map("error_message")
  stdoutLog       String?  @map("stdout_log")
  stderrLog       String?  @map("stderr_log")
  metadata        Json?
  isAnomaly       Boolean  @default(false) @map("is_anomaly")
  anomalyReason   String?  @map("anomaly_reason")
  retentionDays   Int?     @map("retention_days")
  expiresAt       DateTime? @map("expires_at")
  restoreDrillStatus          String?   @map("restore_drill_status")
  restoreDrillDurationSeconds Int?      @map("restore_drill_duration_seconds")
  restoreDrillVerifiedTables  Int?      @map("restore_drill_verified_tables")
  restoreDrillLog             String?   @map("restore_drill_log")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([projectName, createdAt(sort: Desc)])
  @@index([serverId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isAnomaly, createdAt(sort: Desc)])
  @@index([restoreDrillStatus])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
  @@map("backup_reports")
}

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String   // GOOGLE_CHAT, SMTP
  eventType String   @map("event_type") // DAILY_REPORT, TEST_NOTIFICATION, FAILURE_ALERT
  recipient String   // Masked Webhook URL or recipient email(s)
  status    String   // SUCCESS, FAILED
  message   String   // Delivery response message or error description
  payload   Json?    // Summary metrics, subject, or delivery details
  createdAt DateTime @default(now()) @map("created_at")

  @@index([channel, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("notification_logs")
}

model UserLoginLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  username      String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  status        String   // SUCCESS, FAILED
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("user_login_logs")
}

model ServerConfig {
  id          String   @id @default(uuid())
  serverId    String   @unique @map("server_id")
  hostname    String?
  isMonitored Boolean  @default(true) @map("is_monitored") // When false, excluded from Dead Man's Snitch alerts
  muteReason  String?  @map("mute_reason")                 // Reason for excluding (e.g. Decommissioned, Test machine)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("server_configs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("general") // general, notifications, email, retention, security
  description String?
  isEncrypted Boolean  @default(false)     @map("is_encrypted")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now())     @map("created_at")
  updatedAt   DateTime @updatedAt          @map("updated_at")

  @@index([category])
  @@index([key])
  @@map("system_settings")
}

model AdminAuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  username       String
  userRole       String?  @map("user_role")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  action         String   // API_KEY_CREATED, API_KEY_REVOKED, SETTINGS_UPDATED, INCIDENT_RESOLVED, USER_CREATED, USER_UPDATED, USER_DELETED, RETENTION_TRIGGERED
  category       String   // SECURITY, SETTINGS, INCIDENT, USER_MANAGEMENT, SYSTEM
  targetResource String?  @map("target_resource")
  details        Json?
  status         String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([action, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([username, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

// ============================================================================
// Disk Sync & Rsync Mirroring Models
// ============================================================================

model RsyncServer {
  id             String            @id @default(uuid())
  name           String            // e.g. "Primary Storage Node", "Offsite DR Server"
  host           String            // IP address or hostname
  port           Int               @default(22)
  username       String            @default("root")
  authType       String            @default("SSH_KEY") @map("auth_type") // SSH_KEY, PASSWORD, LOCAL
  password       String?           // Masked/Encrypted
  sshPrivateKey  String?           @map("ssh_private_key") @db.Text
  status         String            @default("UNTESTED") // ONLINE, OFFLINE, UNTESTED
  lastCheckedAt  DateTime?         @map("last_checked_at")
  cpuPercent     Float?            @map("cpu_percent")
  memoryPercent  Float?            @map("memory_percent")
  diskPercent    Float?            @map("disk_percent")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  repositories   RsyncRepository[]
  jobsAsSource   RsyncJob[]        @relation("JobSourceServer")
  jobsAsDest     RsyncJob[]        @relation("JobDestServer")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("rsync_servers")
}

model RsyncRepository {
  id             String        @id @default(uuid())
  name           String        // e.g. "Local NVMe Source", "Secondary SATA Mirror"
  type           String        @default("LOCAL_DISK") // LOCAL_DISK, REMOTE_SSH
  serverId       String?       @map("server_id")
  path           String        // e.g. "/data/disk1" or "/mnt/disk2"
  totalBytes     BigInt?       @map("total_bytes")
  usedBytes      BigInt?       @map("used_bytes")
  availableBytes BigInt?       @map("available_bytes")
  isMounted      Boolean       @default(true) @map("is_mounted")
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  server         RsyncServer?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  sourceJobs     RsyncJob[]    @relation("JobSourceRepo")
  destJobs       RsyncJob[]    @relation("JobDestRepo")

  @@index([type])
  @@index([serverId])
  @@index([createdAt(sort: Desc)])
  @@map("rsync_repositories")
}

model RsyncJob {
  id                  String            @id @default(uuid())
  name                String            // e.g. "Daily NVMe Disk Mirror to SATA Pool"
  sourceRepoId        String            @map("source_repo_id")
  sourceSubpath       String?           @map("source_subpath")
  destRepoId          String            @map("dest_repo_id")
  destSubpath         String?           @map("dest_subpath")
  sourceServerId      String?           @map("source_server_id")
  destServerId        String?           @map("dest_server_id")
  syncStrategy        String            @default("EXACT_MIRROR") @map("sync_strategy") // EXACT_MIRROR, HARDLINK_SNAPSHOT, BACKUP_DIR
  cronSchedule        String?           @map("cron_schedule")    // e.g. "0 2 * * *"
  bandwidthLimitKb    Int?              @map("bandwidth_limit_kb")
  excludePatterns     String[]          @default([]) @map("exclude_patterns")
  customArgs          String?           @map("custom_args")
  customCommand       String?           @map("custom_command") @db.Text
  commandMode         String            @default("SYSTEM") @map("command_mode")
  recordTelemetry     Boolean           @default(false) @map("record_telemetry")
  notifyPolicy        String            @default("FAILURE_ONLY") @map("notify_policy")
  preservePermissions Boolean           @default(true) @map("preserve_permissions")
  preserveOwner       Boolean           @default(true) @map("preserve_owner")
  preserveTimes       Boolean           @default(true) @map("preserve_times")
  enableCompression   Boolean           @default(false) @map("enable_compression")
  deleteExtraneous    Boolean           @default(true) @map("delete_extraneous")
  isActive            Boolean           @default(true) @map("is_active")
  lastRunStatus       String?           @map("last_run_status")
  lastRunAt           DateTime?         @map("last_run_at")
  nextRunAt           DateTime?         @map("next_run_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  sourceRepo          RsyncRepository   @relation("JobSourceRepo", fields: [sourceRepoId], references: [id], onDelete: Restrict)
  destRepo            RsyncRepository   @relation("JobDestRepo", fields: [destRepoId], references: [id], onDelete: Restrict)
  sourceServer        RsyncServer?      @relation("JobSourceServer", fields: [sourceServerId], references: [id], onDelete: SetNull)
  destServer          RsyncServer?      @relation("JobDestServer", fields: [destServerId], references: [id], onDelete: SetNull)
  runs                RsyncRun[]

  @@index([isActive])
  @@index([lastRunStatus])
  @@index([createdAt(sort: Desc)])
  @@map("rsync_jobs")
}

model RsyncRun {
  id               String       @id @default(uuid())
  jobId            String       @map("job_id")
  runType          String       @default("MANUAL") @map("run_type") // MANUAL, SCHEDULED, DRY_RUN
  status           String       @default("IN_PROGRESS") // SUCCESS, FAILED, IN_PROGRESS, CANCELLED
  sourcePath       String       @map("source_path")
  destinationPath  String       @map("destination_path")
  totalFiles       Int          @default(0) @map("total_files")
  transferredFiles Int          @default(0) @map("transferred_files")
  deletedFiles     Int          @default(0) @map("deleted_files")
  bytesTransferred BigInt       @default(0) @map("bytes_transferred")
  totalSizeBytes   BigInt       @default(0) @map("total_size_bytes")
  speedupRatio     Float?       @map("speedup_ratio")
  durationSeconds  Float        @default(0) @map("duration_seconds")
  exitCode         Int?         @map("exit_code")
  stdoutLog        String?      @map("stdout_log") @db.Text
  stderrLog        String?      @map("stderr_log") @db.Text
  errorMessage     String?      @map("error_message")
  startedAt        DateTime     @default(now()) @map("started_at")
  completedAt      DateTime?    @map("completed_at")

  job              RsyncJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("rsync_runs")
}

model RsyncActivityLog {
  id         String   @id @default(uuid())
  action     String   // JOB_CREATED, JOB_RUN, JOB_DELETED, SERVER_TESTED, DRY_RUN, REPO_CREATED
  entityId   String?  @map("entity_id")
  entityType String   @map("entity_type") // JOB, SERVER, REPOSITORY, RUN
  username   String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("rsync_activity_logs")
}

