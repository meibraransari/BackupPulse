# ==============================================================================
# Sample Crontab Entries for 100+ Production Servers
# ==============================================================================
# Edit using: crontab -e
# Ensure /usr/local/bin/backup_agent.sh has execute permissions (chmod +x)

# 1. Daily Code Backup at 01:00 AM
0 1 * * * /usr/local/bin/backup_agent.sh --project "main-api" --type "code" --dir "/var/www/main-api" >> /var/log/backup_cron.log 2>&1

# 2. Daily Database Backup at 02:00 AM (e.g. MySQL / MariaDB)
0 2 * * * /usr/local/bin/backup_agent.sh --project "main-db" --type "db" --db-cmd "mysqldump -u root -p'SecretPass' --all-databases" >> /var/log/backup_cron.log 2>&1

# 3. Daily Database Backup for PostgreSQL at 02:30 AM
30 2 * * * /usr/local/bin/backup_agent.sh --project "postgres-db" --type "db" --db-cmd "pg_dump -U postgres -d production_db" >> /var/log/backup_cron.log 2>&1

# 4. Weekly Full Backup (Code + DB) on Sundays at 03:00 AM
0 3 * * 0 /usr/local/bin/backup_agent.sh --project "billing-system" --type "full" --dir "/var/www/billing" --db-cmd "mysqldump -u root billing_prod" >> /var/log/backup_cron.log 2>&1
